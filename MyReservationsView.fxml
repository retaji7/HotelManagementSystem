<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="javafxtesting.controllers.BrowseRoomsController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <!-- Title -->
   <Label text="Browse Available Rooms">
      <font>
         <Font name="System" size="20.0" />
      </font>
   </Label>

   <!-- Filter Section -->
   <HBox spacing="15.0" alignment="CENTER_LEFT">
      <Label text="Filter by Room Type:">
         <font>
            <Font size="13.0" />
         </font>
      </Label>
      <ComboBox fx:id="roomTypeComboBox" promptText="All Types" prefWidth="150.0" />
      <Button text="Apply Filter" onAction="#handleApplyFilter">
         <font>
            <Font size="13.0" />
         </font>
      </Button>
      <Button text="Show All" onAction="#handleShowAll">
         <font>
            <Font size="13.0" />
         </font>
      </Button>
   </HBox>

   <!-- Rooms Table -->
   <TableView fx:id="roomsTable" VBox.vgrow="ALWAYS">
      <columns>
         <TableColumn fx:id="roomNumberColumn" text="Room Number" prefWidth="120.0" />
         <TableColumn fx:id="roomTypeColumn" text="Type" prefWidth="100.0" />
         <TableColumn fx:id="priceColumn" text="Price/Night" prefWidth="100.0" />
         <TableColumn fx:id="capacityColumn" text="Capacity" prefWidth="100.0" />
         <TableColumn fx:id="statusColumn" text="Status" prefWidth="100.0" />
      </columns>
   </TableView>

   <!-- Message Label -->
   <Label fx:id="messageLabel" text="">
      <font>
         <Font size="12.0" />
      </font>
   </Label>

   <!-- Buttons -->
   <HBox spacing="10.0" alignment="CENTER_RIGHT">
      <Button text="Refresh" onAction="#handleRefresh">
         <font>
            <Font size="13.0" />
         </font>
      </Button>
   </HBox>
</VBox>
